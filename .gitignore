# ---- 可重建/大文件产物（不入库）----
build/
jar/
original/
发布/

# ---- 二进制与媒体 ----
*.jar
*.zip
*.png
*.jpg
*.log
*.dat
*.class
*.pyc
__pycache__/

# ---- 补丁发布资产（显式跟踪，覆盖上面的忽略）----
!patch/**
!patch/**/*.class
!patch/**/*.png
!docs/*.png
!docs/screenshots/*.png

# ---- 工具 ----
.reasonix/

# 本机私有指令文件（保留仓库内显式忽略，不只靠全局 gitignore）
AGENTS.local.md

# 环境变量与凭据（绝不入库）
.env
.env.*
!.env.example
